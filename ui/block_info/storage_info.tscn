[gd_scene format=3]

[ext_resource type="Script" uid="uid://dcn10m6he3r3e" path="res://ui/block_info/storage_info.gd" id="1_script"]
[ext_resource type="Theme" uid="uid://djb1bkq82a1wy" path="res://assets/resources/UI_theme.tres" id="2_theme"]

[node name="StorageBlockInfo" type="VBoxContainer"]
size_flags_vertical = 3
theme_override_constants/separation = 6
script = ExtResource("1_script")

[node name="ContentsTitle" type="Label" parent="."]
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "Contents"

[node name="ContentsScroll" type="ScrollContainer" parent="."]
custom_minimum_size = Vector2(0, 92)
layout_mode = 2
horizontal_scroll_mode = 0

[node name="ContentsList" type="VBoxContainer" parent="ContentsScroll"]
layout_mode = 2
size_flags_horizontal = 3

[node name="CapacityBar" type="ProgressBar" parent="."]
custom_minimum_size = Vector2(0, 18)
layout_mode = 2
show_percentage = false

[node name="CapacityLabel" type="Label" parent="."]
layout_mode = 2
text = "0 / 0 mass"

[node name="AllowedTitle" type="Label" parent="."]
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "Allowed items"

[node name="AllowedHint" type="Label" parent="."]
layout_mode = 2
theme_override_colors/font_color = Color(0.7, 0.7, 0.7, 1)
text = "Click an item name to remove it."

[node name="AllowedScroll" type="ScrollContainer" parent="."]
custom_minimum_size = Vector2(0, 130)
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="AllowedList" type="VBoxContainer" parent="AllowedScroll"]
layout_mode = 2
size_flags_horizontal = 3

[node name="AddButton" type="Button" parent="."]
layout_mode = 2
text = "+ Add item"

[node name="AddPopup" type="PopupPanel" parent="."]
size = Vector2i(360, 400)
theme = ExtResource("2_theme")

[node name="Margin" type="MarginContainer" parent="AddPopup"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 12

[node name="VBox" type="VBoxContainer" parent="AddPopup/Margin"]
layout_mode = 2

[node name="Title" type="Label" parent="AddPopup/Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "Add an allowed item"

[node name="Tree" type="Tree" parent="AddPopup/Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3
hide_root = true

[connection signal="pressed" from="AddButton" to="." method="_on_add_button_pressed"]
[connection signal="item_selected" from="AddPopup/Margin/VBox/Tree" to="." method="_on_add_tree_item_selected"]
